Subject: [PATCH] Handle deduplicated property-grid callback typedef

Signed-off-by: Rui Chen <rui@chenrui.dev>
---
 etg/propgriddefs.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/etg/propgriddefs.py b/etg/propgriddefs.py
index d84f46855..f78afaf7b 100644
--- a/etg/propgriddefs.py
+++ b/etg/propgriddefs.py
@@ -37,7 +37,10 @@ def run():
     module.find('wxPG_COLOUR_BLACK').ignore()
     module.find('wxPG_COLOUR').ignore()
     module.find('wxPG_DEFAULT_IMAGE_SIZE').ignore()
-    module.find('wxPGSortCallback').ignore()
+    # Newer Doxygen versions only emit this duplicate typedef in propgrid.h.
+    callback = module.findItem('wxPGSortCallback')
+    if callback is not None:
+        callback.ignore()
 
     module.addPyCode(
         code="""\
