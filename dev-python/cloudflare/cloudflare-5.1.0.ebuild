EAPI=8

DISTUTILS_USE_PEP517=hatchling
PYTHON_COMPAT=( python3_{12..14} )

inherit distutils-r1 eapi9-ver

DESCRIPTION="The official Python library for the Cloudflare API"
HOMEPAGE="
	https://github.com/cloudflare/cloudflare-python
	https://pypi.org/project/cloudflare/
"

MYPN="cloudflare-python"
MYPV=$(ver_rs 3 -)
# Prism archive generated by workflow
# https://github.com/Phoenix591/cloudflare-python/blob/master/.github/workflows/test-tar.yml
SRC_URI="
	https://github.com/cloudflare/cloudflare-python/archive/refs/tags/v${MYPV}.tar.gz
		-> ${MYPN}-${MYPV}.gh.tar.gz
"
S="${WORKDIR}/${MYPN}-${MYPV}"

# nodejs module and deps used to test
LICENSE="Apache-2.0"
SLOT="0"
KEYWORDS="~amd64 ~arm ~arm64 ~ppc ~ppc64 ~riscv ~x86"

# Tests require to spawn a service running locally and many dependencies.
# It didn’t run successfully, and previously was relying on PROPERTIES falg
# "test_network", which I am not sure is safe to keep.
RESTRICT="test"

RDEPEND="
	>=dev-python/anyio-3.5.0[${PYTHON_USEDEP}]
	<dev-python/anyio-5[${PYTHON_USEDEP}]
	>=dev-python/distro-1.7.0[${PYTHON_USEDEP}]
	<dev-python/distro-2[${PYTHON_USEDEP}]
	>=dev-python/httpx-0.23.0[${PYTHON_USEDEP}]
	<dev-python/httpx-1[${PYTHON_USEDEP}]
	>=dev-python/pydantic-2.12[${PYTHON_USEDEP}]
	<dev-python/pydantic-3[${PYTHON_USEDEP}]
	dev-python/sniffio[${PYTHON_USEDEP}]
	>=dev-python/typing-extensions-4.14[${PYTHON_USEDEP}]
	<dev-python/typing-extensions-5[${PYTHON_USEDEP}]
"

