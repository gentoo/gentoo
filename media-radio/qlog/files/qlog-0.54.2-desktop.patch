From 4f2a8e8a587802280a0849242fda1b5ca0e06d0d Mon Sep 17 00:00:00 2001
From: Mario Haustein <mario.haustein@hrz.tu-chemnitz.de>
Date: Sat, 21 Nov 2026 10:02:00 +0100
Subject: [PATCH] Remove redundant keyword from desktop file
Upstream: https://github.com/foldynl/QLog/pull/1249
Bug: https://bugs.gentoo.org/986647

The name `QLog` is redundant in the `Keywords` entry of the desktop
file. This violates the specification (see
https://specifications.freedesktop.org/desktop-entry/latest/recognized-keys.html).
--- a/res/qlog.desktop
+++ b/res/qlog.desktop
@@ -7,5 +7,5 @@ Comment[fr]=Carnet de trafic Radio Amateur
 Exec=qlog
 Icon=qlog
 Categories=Utility;HamRadio;
-Keywords=QLog;Ham;Radio;HamRadio;AmateurRadio;Log;
+Keywords=Ham;Radio;HamRadio;AmateurRadio;Log;
 X-GNOME-UsesNotifications=true
