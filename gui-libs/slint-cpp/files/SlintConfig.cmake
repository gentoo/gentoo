# Generated by Gentoo
set(SLINT_FEATURE_BACKEND_QT ON)

if(NOT TARGET Slint::Slint)
    add_library(Slint::Slint SHARED IMPORTED)
    set_target_properties(Slint::Slint PROPERTIES
        IMPORTED_LOCATION "/usr/lib64/libslint_cpp.so"
        INTERFACE_INCLUDE_DIRECTORIES "/usr/include/slint"
        # libslint_cpp.so is built with the "experimental" cargo feature, so the
        # C++ headers must expose slint::Translator / slint::set_translator() etc.
        # (in slint.h these are guarded by #if defined(SLINT_FEATURE_EXPERIMENTAL)).
        INTERFACE_COMPILE_DEFINITIONS "SLINT_FEATURE_EXPERIMENTAL"
        SLINT_ENABLED_FEATURES "EXPERIMENTAL"
    )
endif()

if(NOT TARGET Slint::slint-compiler)
    add_executable(Slint::slint-compiler IMPORTED)
    set_target_properties(Slint::slint-compiler PROPERTIES
        IMPORTED_LOCATION "/usr/bin/slint-compiler"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SlintMacro.cmake")
