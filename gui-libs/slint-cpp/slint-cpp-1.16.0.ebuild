src_prepare() {
	default
	if use test; then
		# Restore the C++ test driver crates in the workspace
		eapply "${FILESDIR}"/"${P}-tests-cargo.patch" || die
	fi
}

src_compile() {
	# The C++ translator API (slint::Translator, slint::set_translator()) is
	# only compiled into libslint_cpp.so when the "experimental" cargo feature
	# is enabled (see api/cpp/lib.rs: #[cfg(all(feature = "experimental", ...))]).
	# LibrePCB requires it for its Qt-based Slint translator.
	#
	# The "backend-qt" cargo feature pulls in the i-slint-backend-qt crate, which
	# provides the slint_qt_get_widget() symbol used by LibrePCB to embed Slint
	# windows into its Qt UI (see internal/backends/qt/lib.rs). Without it the
	# symbol is missing from libslint_cpp.so and LibrePCB fails to link.
	cargo_src_compile --package slint-cpp --package slint-compiler \
		--features slint-cpp/experimental,slint-cpp/backend-qt
}

src_install() {
	patchelf --set-soname "libslint_cpp.so.${PV}" target/release/libslint_cpp.so || die
	dolib.so target/release/libslint_cpp.so
	dosym "libslint_cpp.so" "/usr/$(get_libdir)/libslint_cpp.so.${PV}"

	# Install headers (including the private/ subdirectory)
	insinto /usr/include/slint
	doins -r "${S}"/api/cpp/include/*

	# Install the headers generated by cbindgen at build time
	# (e.g. private/slint_internal.h in $OUT_DIR/generated_include)
	local gen_include
	gen_include=$(find "${S}"/target/release/build -maxdepth 4 -type d -name generated_include 2>/dev/null | head -n 1)
	[[ -d ${gen_include} ]] || die "generated slint headers not found"
	doins -r "${gen_include}"/*

	# Install slint-compiler
	dobin target/release/slint-compiler

	# Install CMake config files
	insinto /usr/$(get_libdir)/cmake/Slint
	doins "${S}"/api/cpp/cmake/SlintMacro.cmake
	doins "${FILESDIR}"/SlintConfig.cmake
}

src_test() {
	local -x QT_QPA_PLATFORM=offscreen
	cargo test --release -p test-driver-cpp || die
}
