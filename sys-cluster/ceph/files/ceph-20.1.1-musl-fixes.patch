From 8c001ce00dced554ebdc244eb0be03c71403bad3 Mon Sep 17 00:00:00 2001
From: "Z. Liu" <zhixu.liu@gmail.com>
Date: Sun, 1 Nov 2026 19:06:38 +0800
Subject: [PATCH 3/5] common: define missing TCP option constants

musl's <netinet/tcp.h> does not define TCPI_OPT_ECN_SEEN or
TCPI_OPT_SYN_DATA. These constants are defined in <linux/tcp.h>,
which conflicts with <netinet/tcp.h>. Define them locally to avoid
including the conflicting Linux UAPI header.

Signed-off-by: Z. Liu <zhixu.liu@gmail.com>

diff --git a/src/common/tcp_info.cc b/src/common/tcp_info.cc
index 85a34877457..69cccbefadf 100644
--- a/src/common/tcp_info.cc
+++ b/src/common/tcp_info.cc
@@ -15,6 +15,15 @@
 
 #include "common/tcp_info.h"
 
+// musl's <netinet/tcp.h> lacks these Linux TCP ABI constants.
+// Avoid including <linux/tcp.h>, which conflicts with <netinet/tcp.h>.
+#ifndef TCPI_OPT_ECN_SEEN
+# define TCPI_OPT_ECN_SEEN 16 /* we received at least one packet with ECT */
+#endif
+#ifndef TCPI_OPT_SYN_DATA
+# define TCPI_OPT_SYN_DATA 32 /* SYN-ACK acked data in SYN sent or rcvd */
+#endif
+
 #include "common/Formatter.h"
 
 namespace ceph {
-- 
