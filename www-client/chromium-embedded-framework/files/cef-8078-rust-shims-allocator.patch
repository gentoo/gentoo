+    rebase_path("dummy.rs", root_build_dir),
+    rebase_path("$target_gen_dir", root_build_dir),
+    _rustc_bin_path
+  ]
+}
+
+static_library("rust_alloc_shims") {
+  sources = [ "$target_gen_dir/rust_alloc_shims.o" ]
+  visibility = [ "*" ]
+}
