diff -Naur dosbox-staging-0.83.0.orig/src/gui/CMakeLists.txt dosbox-staging-0.83.0/src/gui/CMakeLists.txt
--- dosbox-staging-0.83.0.orig/src/gui/CMakeLists.txt
+++ dosbox-staging-0.83.0/src/gui/CMakeLists.txt
@@ -17,5 +17,9 @@
 )
 
 target_link_libraries(libdosboxcommon PRIVATE
-  OpenGL::GL
-  $<IF:$<BOOL:${C_OPENGL}>,libglad,>)
+  $<IF:$<BOOL:${C_OPENGL}>,OpenGL::GL,>
