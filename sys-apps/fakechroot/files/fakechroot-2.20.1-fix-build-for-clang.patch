From 7dec1d6d94cffab2d1968a1c0e5b665439e33c32 Mon Sep 17 00:00:00 2001
From: "Z. Liu" <zhixu.liu@gmail.com>
Date: Tue, 20 Oct 2026 15:09:18 +0800
Subject: [PATCH 1/2] drop unused fakechroot_wrapper::func member

The func member of struct fakechroot_wrapper is never used: lazy
resolution only needs nextfunc and name (see fakechroot_loadfunc).
Initializing it from the wrapped function name makes the
wrapper_alias() wrappers take the address of functions that glibc
fortify headers turn into overloaded (pass_object_size / builtin)
versions, which fails with clang, e.g.:

  open64.c:32:15: error: address of overloaded function 'open64' is ambiguous

Since the member is dead weight, simply remove it.

Signed-off-by: Z. Liu <zhixu.liu@gmail.com>

diff --git a/src/libfakechroot.h b/src/libfakechroot.h
index 4cf199f..56c7a6d 100644
--- a/src/libfakechroot.h
+++ b/src/libfakechroot.h
@@ -143,7 +143,6 @@
 
 #define wrapper_decl(function) \
     LOCAL struct fakechroot_wrapper fakechroot_##function##_wrapper_decl SECTION_DATA_FAKECHROOT = { \
-        (fakechroot_wrapperfn_t) function, \
         NULL, \
         #function \
     }
@@ -204,7 +203,6 @@
 typedef void (*fakechroot_wrapperfn_t)(void);
 
 struct fakechroot_wrapper {
-    fakechroot_wrapperfn_t func;
     fakechroot_wrapperfn_t nextfunc;
     const char *name;
 };
-- 
