+  if (!CheckRawTs(start, end)) {
     debug_print("Signal %p async copy time stamps may be invalid (start=%" PRIu64 ", end=%" PRIu64 ", t0=%" PRIu64 ").\n",
                 &signal->signal_, start, end, t0_.GPUClockCounter);
     time.start = 0;
@@ -3229,6 +3229,24 @@ void GpuAgent::TranslateTime(core::Signal* signal, hsa_amd_profiling_async_copy_
   time.start = TranslateTime(start);
 }
 
+bool GpuAgent::CheckRawTs(uint64_t start, uint64_t end) {
+  if ((start == 0) || (end == 0)) return false;
+
+  std::lock_guard<std::mutex> lock(t1_lock_);
+#ifndef _WIN32
+  // The GPU timestamp counter (CP, SDMA, s_memrealtime) can restart from 0 on resume from
+  // suspend (e.g. s2idle on gfx1151), while the KFD clock counter keeps counting.  Ticks
+  // written after agent creation can't predate t0_, so estimate the new epoch offset,
+  // assuming that the packet has just completed.
+  if ((end >= start) && (end - gpu_clock_offset_ < t0_.GPUClockCounter)) {
+    SyncClocks();
+    gpu_clock_offset_ = int64_t(end - t1_.GPUClockCounter);
+  }
+#endif
+  return (start - gpu_clock_offset_ >= t0_.GPUClockCounter) &&
+      (end - gpu_clock_offset_ >= t0_.GPUClockCounter);
+}
