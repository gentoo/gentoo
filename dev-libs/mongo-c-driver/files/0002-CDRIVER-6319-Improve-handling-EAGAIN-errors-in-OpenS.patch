@@ -196,6 +196,9 @@ static BSON_THREAD_FUN (ssl_test_client, ptr)
 
    sock_stream = mongoc_stream_socket_new (conn_sock);
    BSON_ASSERT (sock_stream);
+   if (data->client_stream_wrapper) {
