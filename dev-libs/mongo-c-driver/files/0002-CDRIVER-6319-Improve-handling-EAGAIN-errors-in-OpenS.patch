Subject: [PATCH 2/2] CDRIVER-6319 Improve handling `EAGAIN` errors in OpenSSL
 BIO read callbacks (#2297)

* Extend ssl_test API to support client stream wrappers
* Add regression test for EAGAIN behavior
* Re-enable "run auth tests" for OpenSSL compat matrix
---
 .../mongoc/mongoc-stream-tls-openssl-bio.c    |  13 ++-
 src/libmongoc/tests/ssl-test.c                |  77 +++++++------
 src/libmongoc/tests/ssl-test.h                |   9 ++
 src/libmongoc/tests/test-mongoc-stream-tls.c  | 104 +++++++++++++++++-
 4 files changed, 165 insertions(+), 38 deletions(-)

diff --git a/src/libmongoc/src/mongoc/mongoc-stream-tls-openssl-bio.c b/src/libmongoc/src/mongoc/mongoc-stream-tls-openssl-bio.c
index ba77ec3..8cb0732 100644
--- a/src/libmongoc/src/mongoc/mongoc-stream-tls-openssl-bio.c
+++ b/src/libmongoc/src/mongoc/mongoc-stream-tls-openssl-bio.c
@@ -224,15 +224,18 @@ mongoc_stream_tls_openssl_bio_read (BIO *b, char *buf, int len)
    openssl = (mongoc_stream_tls_openssl_t *) tls->ctx;
 
    errno = 0;
-   const ssize_t ret = mongoc_stream_read (tls->base_stream, buf, (size_t) len, 0, (int32_t) tls->timeout_msec);
+   ssize_t ret = mongoc_stream_read(tls->base_stream, buf, (size_t)len, 0, (int32_t)tls->timeout_msec);
    BIO_clear_retry_flags (b);
 
    if ((ret <= 0) && MONGOC_ERRNO_IS_AGAIN (errno)) {
-      /* this BIO is not the same as "b", which openssl passed in to this func.
-       * set its retry flag, which we check with BIO_should_retry in
-       * mongoc-stream-tls-openssl.c
-       */
+      // Set the retry flag for the BIO used by functions in mongoc-stream-tls-openssl.c.
       BIO_set_retry_read (openssl->bio);
+
+      // Also set the retry flag for the BIO used by OpenSSL.
+      BIO_set_retry_read(b);
+
+      // EAGAIN is an error (negative value), not an EOF (zero).
+      ret = -1;
    }
 
    BSON_ASSERT (mcommon_in_range_signed (int, ret));
diff --git a/src/libmongoc/tests/ssl-test.c b/src/libmongoc/tests/ssl-test.c
