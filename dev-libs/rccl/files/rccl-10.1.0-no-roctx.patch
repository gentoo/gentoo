index 16e815f..8b733a4 100644
--- a/src/include/nvtx.h
+++ b/src/include/nvtx.h
@@ -8,6 +8,10 @@
 #ifndef NCCL_NVTX_H_
 #define NCCL_NVTX_H_
 
+#ifdef NVTX_NO_IMPL
+#include "nvtx_stub.h"
+#else
+
 #include "nvtx3/nvtx3.hpp"
 #include "roctx.h"
 
@@ -243,4 +247,6 @@ private:
 
 extern void initNvtxRegisteredEnums();
 
+#endif // NVTX_NO_IMPL
+
 #endif
