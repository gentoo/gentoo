Fix build without roctx

With ROCTX=OFF (or roctracer not found) rccl defines NVTX_NO_IMPL and core.h
includes nvtx_stub.h, but several sources include nvtx.h directly and rely on
headers that only roctx.h pulls in.
diff --git a/src/algorithms/dda/ipc/ipc_init.cu b/src/algorithms/dda/ipc/ipc_init.cu
index 73faafd..ce7bee5 100644
--- a/src/algorithms/dda/ipc/ipc_init.cu
+++ b/src/algorithms/dda/ipc/ipc_init.cu
@@ -13,6 +13,7 @@
 #include "debug.h"
 #include "algorithms/dda/dda_init_detail.h"
 #include "algorithms/dda/ipc/ipc_mem_handler.h"
+#include <iostream>
 
 #include <cuda_runtime.h>
 
