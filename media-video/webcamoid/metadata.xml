<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
	<!-- maintainer-needed -->
	<upstream>
		<remote-id type="github">webcamoid/webcamoid</remote-id>
	</upstream>
	<use>
		<flag name="libusb">Enable video capturing from USB devices using <pkg>dev-libs/libusb</pkg></flag>
		<flag name="libuvc">Enable video capturing from USB devices using <pkg>media-libs/libuvc</pkg></flag>
		<flag name="pipewire">Enable audio/video/screen capture using PipeWire</flag>
		<flag name="qtcamera">Enable video capture using Qt</flag>
		<flag name="qtscreen">Enable screen capture using Qt</flag>
		<flag name="screencast">Enable screen capture using FFmpeg</flag>
		<flag name="wayland">Enable screen capture using Wayland</flag>
		<flag name="X">Enable screen capture using Xlib</flag>
	</use>
</pkgmetadata>
