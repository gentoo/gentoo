Index: src/plugins/contrib/AutoVersioning/Makefile.am
===================================================================
--- a/src/plugins/contrib/AutoVersioning/Makefile.am	(revision 13854)
+++ b/gsrc/plugins/contrib/AutoVersioning/Makefile.am	(revision 13855)
@@ -11,6 +11,10 @@
 libAutoVersioning_la_LIBADD = ../../../sdk/libcodeblocks.la \
 			$(WX_LIBS)
 
+if ! CODEBLOCKS_NT
+libAutoVersioning_la_LIBADD += $(CB_TINYXML_LIBS)
+endif
+
