From 0baa39943fa4d11fc78740d9542dd36f20d7e074 Mon Sep 17 00:00:00 2001
From: "Z. Liu" <zhixu.liu@gmail.com>
Date: Sun, 15 Nov 2026 20:44:32 +0800
Subject: [PATCH 4/4] include fstream to fix build w/ gcc 17

build w/ gcc 17 failed with:

> op_bfd.h:228:61: error: 'std::ifstream' has not been declared
>   228 | void get_kallsym_symbols(symbols_found_t & symbols, std::ifstream& infile);
>       |                                              ^~~
> op_bfd.h:27:1: note: 'std::ifstream' is defined in header '<fstream>'; this is probably fixable by adding '#include <fstream>'

Signed-off-by: Z. Liu <zhixu.liu@gmail.com>

diff --git a/libutil++/op_bfd.h b/libutil++/op_bfd.h
index c7092b0c..cf9d9d2b 100644
--- a/libutil++/op_bfd.h
+++ b/libutil++/op_bfd.h
@@ -19,6 +19,7 @@
 #include <list>
 #include <map>
 #include <set>
+#include <fstream>
 
 #include "bfd_support.h"
 #include "locate_images.h"
-- 
2.49.1

