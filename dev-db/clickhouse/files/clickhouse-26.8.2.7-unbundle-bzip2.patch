--- a/contrib/bzip2-cmake/CMakeLists.txt
+++ b/contrib/bzip2-cmake/CMakeLists.txt
@@ -1,3 +1,10 @@
+find_library(BZIP2_LIB NAMES bz2 REQUIRED)
+find_path(BZIP2_INC NAMES bzlib.h REQUIRED)
+add_library(_bzip2 INTERFACE)
+target_link_libraries(_bzip2 INTERFACE ${BZIP2_LIB})
+target_include_directories(_bzip2 SYSTEM INTERFACE ${BZIP2_INC})
+add_library(ch_contrib::bzip2 ALIAS _bzip2)
+return()
 option(ENABLE_BZIP2 "Enable bzip2 compression support" ${ENABLE_LIBRARIES})
 if (NOT ENABLE_BZIP2)
     message (STATUS "Not using bzip2")
