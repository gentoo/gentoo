# /etc/conf.d/nzbget
# Config file for nzbget init script

# Which user to run nzbget as
NZBGET_USER="nzbget"
NZBGET_GROUP="nzbget"

# Location of config file
NZBGET_CONFIGFILE="/etc/nzbgetd.conf"

# Other options
NZBGET_OPTS=""

# Passed to start-stop-daemon's "retry" parameter.
# By default, send SIGTERM, wait for up to 30 seconds before sending SIGKILL,
# then fail if the service hasn't stopped after 5 more seconds.
#NZBGET_TERMTIMEOUT="TERM/30/KILL/5"
