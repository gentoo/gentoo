Modified for gentoo build (adapt diff path) by Thomas Beierlein <tomjbe@gentoo,org>
---
 host/include/uhd/utils/CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/include/uhd/utils/CMakeLists.txt b/include/uhd/utils/CMakeLists.txt
index 6c380f0433..d1e3d78e77 100644
--- a/include/uhd/utils/CMakeLists.txt
+++ b/include/uhd/utils/CMakeLists.txt
@@ -24,6 +24,7 @@ UHD_INSTALL(FILES
     interpolation.hpp
     log.hpp
     log_add.hpp
