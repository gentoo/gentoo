                 DRegsT result;
                 to_native_vector(result)
                     = {__builtin_amdgcn_wmma_f32_16x16x32_f16((bool)InputAMod,
-                                                              to_native_vector(regsA),
+                                                              to_native_vector(reinterpret_cast<TypeAB const&>(regsA)),
